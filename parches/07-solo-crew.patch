     }
     return undefined;
 }
+
+/**
+ * HOT SPOT S.L.: salas solo para el crew (gente que ha entrado con su cuenta a través de /cuentas).
+ * Los invitados (sin cuenta) se quedan en la calle. Solo se aplica si el acceso con cuenta está
+ * configurado (OPENID_CLIENT_ID); si no, la oficina funciona como antes.
+ */
+export const HOTSPOT_SALAS_CREW = ["hotspot/hq.wam", "hotspot/terraza.wam"];
+
+export function salaSoloCrew(roomUrl: string): boolean {
+    let ruta: string;
+    try {
+        ruta = new URL(roomUrl, "http://x").pathname;
+    } catch {
+        return false;
+    }
+    const interna = salaDesdeRuta(ruta) ?? salaDesdeMapaSuelto(ruta) ?? ruta;
+    const m = /^\/~\/(.+?)(?:\.tmj|\.wam)?$/.exec(interna);
+    if (!m) return false;
+    return HOTSPOT_SALAS_CREW.includes(m[1] + ".wam");
+}
