+    /**
+     * HOT SPOT S.L.: la letra de las burbujas de «decir» y «pensar», a un tamaño que caiga en puntos enteros de la
+     * pantalla. La letra de la casa (Pixelify Sans) es de píxeles: se ve limpia cuando cada punto suyo mide un número
+     * entero de puntos de la pantalla (a 10,75 px, un punto de la letra es 1 px). Las burbujas se amplían con el juego,
+     * y con una ampliación que no es entera (×1,5 en una ventana de 1280 px) una letra fija de 11 px salía con medios
+     * píxeles. Aquí se mide la ampliación de verdad y se elige el tamaño; hotspot-retro.css lo usa (--hs-letra y
+     * --hs-interlinea) y, si no llegara, se queda en 11 px. En pantalla nunca baja de unos 15 px.
+     */
+    private ajustarLetraDeBurbuja(elemento: HTMLElement): void {
+        const PUNTO = 10.75;
+        const medida = this.scene.usernameDomLayer?.getAncestorScale();
+        const ampliacion = typeof medida === "number" && medida > 0.2 ? medida : 1; // px de la página por px del mapa
+        const densidad = window.devicePixelRatio > 0 ? window.devicePixelRatio : 1;
+        const minimo = Math.ceil((15 * densidad) / PUNTO - 0.01);
+        const puntos = Math.max(minimo, Math.round((11 * ampliacion * densidad) / PUNTO));
+        const enElMapa = ampliacion * densidad;
+        elemento.style.setProperty("--hs-letra", `${((PUNTO * puntos) / enElMapa).toFixed(3)}px`);
+        elemento.style.setProperty("--hs-interlinea", `${(Math.round(PUNTO * puntos * 1.2) / enElMapa).toFixed(3)}px`);
+    }
