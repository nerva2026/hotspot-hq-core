diff --git a/play/src/pusher/services/HotspotSalas.ts b/play/src/pusher/services/HotspotSalas.ts
new file mode 100644
index 0000000..d813a9f
--- /dev/null
+++ b/play/src/pusher/services/HotspotSalas.ts
@@ -0,0 +1,29 @@
+/**
+ * HOT SPOT S.L.: direcciones cortas de la oficina.
+ *
+ * oficina.hot-spot.es/calle, /oficina y /terraza abren los mapas de map-storage sin enseñar la ruta
+ * interna (/~/hotspot/…). Las direcciones largas de siempre, y las salidas de los mapas que apuntan
+ * a «hq.tmj», «calle.tmj»…, redirigen a la corta, así que todo el mundo acaba en la misma sala.
+ */
+export const HOTSPOT_SALAS: Record<string, string> = {
+    calle: "hotspot/calle.wam",
+    oficina: "hotspot/hq.wam",
+    terraza: "hotspot/terraza.wam",
+};
+
+/** Mapa de map-storage para una dirección corta («/oficina» → «hotspot/hq.wam»). */
+export function salaDesdeRuta(pathname: string): string | undefined {
+    const m = /^\/([a-z0-9-]+)\/?$/.exec(pathname);
+    return m ? HOTSPOT_SALAS[m[1]] : undefined;
+}
+
+/** Dirección corta de un mapa, si la tiene. Acepta «hotspot/hq.wam», «hotspot/hq.tmj» o solo «hq.tmj». */
+export function rutaCortaDesdeMapa(mapPath: string): string | undefined {
+    const limpio = mapPath.replace(/^\/+/, "").replace(/\.tmj$/, ".wam");
+    for (const [sala, ruta] of Object.entries(HOTSPOT_SALAS)) {
+        if (ruta === limpio || (!limpio.includes("/") && ruta.endsWith("/" + limpio))) {
+            return "/" + sala;
+        }
+    }
+    return undefined;
+}
