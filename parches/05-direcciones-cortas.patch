diff --git a/play/src/pusher/services/HotspotSalas.ts b/play/src/pusher/services/HotspotSalas.ts
new file mode 100644
index 0000000..81f7a38
--- /dev/null
+++ b/play/src/pusher/services/HotspotSalas.ts
@@ -0,0 +1,32 @@
+/**
+ * HOT SPOT S.L.: direcciones cortas de la oficina.
+ *
+ * oficina.hot-spot.es/calle, /oficina y /terraza son alias de los mapas de map-storage. Por dentro, la sala
+ * sigue siendo la de siempre (/~/hotspot/…), que es la que entiende el servidor «back»; el navegador solo
+ * enseña la dirección corta (ver play/src/front/Url/HotspotSalas.ts).
+ */
+export const HOTSPOT_SALAS: Record<string, string> = {
+    calle: "hotspot/calle.wam",
+    oficina: "hotspot/hq.wam",
+    terraza: "hotspot/terraza.wam",
+};
+
+/** Sala interna para una dirección corta («/oficina» → «/~/hotspot/hq.wam»). */
+export function salaDesdeRuta(pathname: string): string | undefined {
+    const m = /^\/([a-z0-9-]+)\/?$/.exec(pathname);
+    const mapa = m ? HOTSPOT_SALAS[m[1]] : undefined;
+    return mapa ? "/~/" + mapa : undefined;
+}
+
+/**
+ * Sala interna para un mapa suelto («/hq.tmj», «/calle.wam»): pasa cuando una salida relativa del mapa
+ * se resuelve desde una dirección corta.
+ */
+export function salaDesdeMapaSuelto(pathname: string): string | undefined {
+    const m = /^\/([^/]+)\.(?:tmj|wam)$/.exec(pathname);
+    if (!m) return undefined;
+    for (const mapa of Object.values(HOTSPOT_SALAS)) {
+        if (mapa.endsWith("/" + m[1] + ".wam")) return "/~/" + mapa;
+    }
+    return undefined;
+}
