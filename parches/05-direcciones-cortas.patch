+++ b/play/src/front/Url/HotspotSalas.ts
@@ -0,0 +1,18 @@
+/**
+ * HOT SPOT S.L.: direcciones cortas de la oficina (misma lista que play/src/pusher/services/HotspotSalas.ts).
+ * La sala interna sigue siendo /~/hotspot/…; en la barra de direcciones se enseña la corta.
+ */
+const HOTSPOT_SALAS: Record<string, string> = {
+    calle: "hotspot/calle.wam",
+    oficina: "hotspot/hq.wam",
+    terraza: "hotspot/terraza.wam",
+};
+
+/** «~/hotspot/hq.wam» (id de sala, sin barra inicial) → «oficina». */
+export function aliasDeSala(roomId: string): string | undefined {
+    const limpio = roomId.replace(/^\/+/, "");
+    for (const [alias, mapa] of Object.entries(HOTSPOT_SALAS)) {
+        if (limpio === "~/" + mapa) return alias;
+    }
+    return undefined;
+}
